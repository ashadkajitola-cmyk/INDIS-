<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cricket Central - Admin Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 flex flex-col font-sans min-h-screen">
  <div id="root">
    <header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50 px-4 py-3 flex items-center justify-between shadow-md">
      <div class="flex items-center space-x-3 cursor-pointer">
        <span class="text-xl">←</span>
        <span class="font-bold text-lg tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-400">Cricket Central</span>
      </div>
      <div class="flex items-center space-x-2">
        <button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-blue-600 text-white shadow">MATCHES</button>
        <button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700">POINTS TABLE</button>
        <button class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700">GROUPS</button>
      </div>
    </header>

    <div class="p-4 max-w-4xl mx-auto w-full flex-grow">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl mb-6">
        <h3 class="text-xl font-bold mb-4 text-indigo-400 flex items-center gap-2">Admin Dashboard</h3>
        <div class="mb-6 flex gap-2">
          <input type="password" placeholder="Enter Admin Secret Password..." class="bg-slate-950 border border-slate-700 px-4 py-2 rounded-xl w-full text-sm focus:outline-none focus:border-indigo-500">
          <button class="bg-indigo-600 hover:bg-indigo-500 px-5 py-2 rounded-xl text-sm font-bold shadow">Login</button>
        </div>

        <div class="space-y-6">
          <div class="p-4 bg-emerald-950/30 border border-emerald-800/50 rounded-xl">
            <p class="text-emerald-400 font-semibold mb-4 text-sm">✔ Logged In Successfully</p>
            
            <div class="space-y-4">
              <h4 class="font-bold text-sm text-slate-200">📂 1. Create Tournament Group</h4>
              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Format</label>
                <select class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-sm">
                  <option value="test">Test (WTC)</option>
                  <option value="odi">ODI</option>
                  <option value="t20">T20I</option>
                </select>
              </div>
              <div><label class="block text-xs font-medium text-slate-400 mb-1">Group Name</label></div>
              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Select Teams</label>
                <div class="grid grid-cols-2 gap-2 max-h-40 overflow-y-auto p-2 bg-slate-950 border border-slate-800 rounded-xl"></div>
              </div>
              <button class="w-full bg-emerald-600 hover:bg-emerald-500 py-2 rounded-xl text-sm font-bold shadow">Create Group</button>
            </div>

            <hr class="border-slate-800 my-6">

            <div class="space-y-4">
              <h4 class="font-bold text-sm text-slate-200">📅 2. Add Match Schedule</h4>
              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Series Type</label>
                <select class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-sm">
                  <option value="existing">Usi Series ka match hai</option>
                  <option value="new">New Series ka match hai</option>
                </select>
              </div>
              <button class="w-full bg-indigo-600 hover:bg-indigo-500 py-2 rounded-xl text-sm font-bold shadow">Add Match</button>
            </div>

            <hr class="border-slate-800 my-6">

            <div class="space-y-4">
              <h4 class="font-bold text-sm text-slate-200">⚡ 3. Update Global Rankings</h4>
              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Format</label>
                <select class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-sm">
                  <option value="test">Test (WTC)</option>
                  <option value="odi">ODI</option>
                  <option value="t20">T20I</option>
                </select>
              </div>
              <div>
                <select class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-sm">
                  <option value="team1">Team 1 Wins</option>
                  <option value="team2">Team 2 Wins</option>
                  <option value="draw">Draw / Tie</option>
                  <option value="nr">No Result / Abandoned</option>
                </select>
              </div>
              <button class="w-full bg-amber-600 hover:bg-amber-500 py-2 rounded-xl text-sm font-bold shadow">Apply Global Match Result</button>
            </div>

            <hr class="border-slate-800 my-6">

            <div class="space-y-4">
              <h4 class="font-bold text-sm text-slate-200">🏆 4. Update Custom Group Points Table</h4>
              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Select Group</label>
                <select class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-sm"></select>
              </div>
              <div><input type="number" placeholder="Team 1 Score / Overs" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-sm"></div>
              <div><input type="number" placeholder="Team 2 Score / Overs" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-sm"></div>
              <button class="w-full bg-indigo-600 hover:bg-indigo-500 py-2 rounded-xl text-sm font-bold shadow">Update Group Points</button>
            </div>

            <hr class="border-slate-800 my-6">

            <div class="space-y-4">
              <h4 class="font-bold text-sm text-slate-200">🎯 5. Set Group Qualification Rules</h4>
              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Select Group</label>
                <select class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-sm"></select>
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-400 mb-1">Top Teams to Qualify</label>
                <input type="number" placeholder="e.g. 2" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-sm">
              </div>
              <button class="w-full bg-purple-600 hover:bg-purple-500 py-2 rounded-xl text-sm font-bold shadow">Save Rules & Generate Next Stage</button>
            </div>

            <hr class="border-slate-800 my-6">

            <div class="space-y-4">
              <h4 class="font-bold text-sm text-slate-200">🔄 6. Reset WTC Test Standings</h4>
              <button class="w-full bg-rose-600 hover:bg-rose-500 py-2 rounded-xl text-sm font-bold shadow">Reset WTC Table</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
